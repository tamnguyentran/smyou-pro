# DEV/TEST on the MacBook Pro M2. Copy to .env.dev (make setup does this). Never commit .env.dev.
APP_ENV=development            # development | test | production
APP_TIMEZONE=Asia/Ho_Chi_Minh

# PostgreSQL
POSTGRES_USER=smyou
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=smyou
DB_PORT=5442                   # host port of the dev Postgres (5432/5433 are taken on the dev Mac)
DATABASE_URL=postgresql+psycopg://smyou:change-me-dev@localhost:5442/smyou   # inside compose: @db:5432
TEST_DATABASE_URL=postgresql+psycopg://smyou:change-me-dev@localhost:5442/smyou_test

# Auth — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-dev-only
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false            # true in production (HTTPS)
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# Files
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=10

# Web
BACKEND_PORT=8010
VITE_PORT=5183
CORS_ORIGINS=http://localhost:5183
WEB_PORT=8080
