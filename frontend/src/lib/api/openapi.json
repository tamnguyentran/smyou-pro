{
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 1024,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": ["current_password", "new_password"],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "EmployeeCreate": {
        "properties": {
          "department": {
            "enum": ["MANAGEMENT", "SALES", "TECHNICAL"],
            "title": "Department",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "roles": {
            "items": {
              "enum": ["MANAGER", "SALE", "TECH_LEAD", "TECHNICIAN"],
              "type": "string"
            },
            "minItems": 1,
            "title": "Roles",
            "type": "array"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": ["full_name", "email", "department", "roles"],
        "title": "EmployeeCreate",
        "type": "object"
      },
      "EmployeeOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "department": {
            "title": "Department",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "is_locked": {
            "title": "Is Locked",
            "type": "boolean"
          },
          "must_change_password": {
            "title": "Must Change Password",
            "type": "boolean"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "code",
          "full_name",
          "email",
          "phone",
          "department",
          "title",
          "roles",
          "is_active",
          "is_locked",
          "must_change_password",
          "version"
        ],
        "title": "EmployeeOut",
        "type": "object"
      },
      "EmployeePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EmployeeOut"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": ["items", "total", "limit", "offset"],
        "title": "EmployeePage",
        "type": "object"
      },
      "EmployeeSummary": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": ["id", "code", "full_name", "roles"],
        "title": "EmployeeSummary",
        "type": "object"
      },
      "EmployeeUpdate": {
        "properties": {
          "department": {
            "anyOf": [
              {
                "enum": ["MANAGEMENT", "SALES", "TECHNICAL"],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 254,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "full_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": ["version"],
        "title": "EmployeeUpdate",
        "type": "object"
      },
      "EmployeeWithPassword": {
        "properties": {
          "employee": {
            "$ref": "#/components/schemas/EmployeeOut"
          },
          "temporary_password": {
            "title": "Temporary Password",
            "type": "string"
          }
        },
        "required": ["employee", "temporary_password"],
        "title": "EmployeeWithPassword",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "database": {
            "const": "ok",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["status", "database", "version"],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "properties": {
          "employee": {
            "$ref": "#/components/schemas/EmployeeSummary"
          },
          "must_change_password": {
            "title": "Must Change Password",
            "type": "boolean"
          }
        },
        "required": ["employee", "must_change_password"],
        "title": "LoginResponse",
        "type": "object"
      },
      "MeEmployee": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "department": {
            "title": "Department",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": ["id", "code", "full_name", "email", "title", "department"],
        "title": "MeEmployee",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "capabilities": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Capabilities",
            "type": "object"
          },
          "counters": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Counters",
            "type": "object"
          },
          "employee": {
            "$ref": "#/components/schemas/MeEmployee"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": ["employee", "roles", "capabilities", "counters"],
        "title": "MeResponse",
        "type": "object"
      },
      "RolesRequest": {
        "properties": {
          "roles": {
            "items": {
              "enum": ["MANAGER", "SALE", "TECH_LEAD", "TECHNICIAN"],
              "type": "string"
            },
            "minItems": 1,
            "title": "Roles",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": ["version", "roles"],
        "title": "RolesRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionRequest": {
        "properties": {
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": ["version"],
        "title": "VersionRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SMYou Pro API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/change-password": {
      "post": {
        "operationId": "auth_change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "problem+json — UNAUTHENTICATED: Vui lòng đăng nhập."
          },
          "422": {
            "description": "problem+json — VALIDATION_ERROR (current_password / new_password)"
          },
          "423": {
            "description": "problem+json — ACCOUNT_LOCKED: Tài khoản tạm khoá do đăng nhập sai nhiều lần. Vui lòng thử lại sau 15 phút."
          }
        },
        "summary": "Đổi mật khẩu của chính mình",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "problem+json — INVALID_CREDENTIALS: Email hoặc mật khẩu không đúng."
          },
          "403": {
            "description": "problem+json — ACCOUNT_DISABLED: Tài khoản đã bị vô hiệu hoá. Vui lòng liên hệ quản lý."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "423": {
            "description": "problem+json — ACCOUNT_LOCKED: Tài khoản tạm khoá do đăng nhập sai nhiều lần. Vui lòng thử lại sau 15 phút."
          }
        },
        "summary": "Đăng nhập bằng email và mật khẩu",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Đăng xuất",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "auth_refresh",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "problem+json — UNAUTHENTICATED: Vui lòng đăng nhập. | SESSION_REVOKED: Phiên đăng nhập đã bị thu hồi. Vui lòng đăng nhập lại."
          }
        },
        "summary": "Làm mới phiên đăng nhập (xoay vòng refresh token)",
        "tags": ["auth"]
      }
    },
    "/api/v1/employees": {
      "get": {
        "operationId": "employees_list",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": ["MANAGER", "SALE", "TECH_LEAD", "TECHNICIAN"],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Role"
            }
          },
          {
            "in": "query",
            "name": "is_active",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Is Active"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Danh sách nhân viên (tìm, lọc, phân trang)",
        "tags": ["employees"]
      },
      "post": {
        "operationId": "employees_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployeeCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeWithPassword"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "problem+json — CONFLICT (email)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Thêm nhân viên (mật khẩu tạm hiện một lần)",
        "tags": ["employees"]
      }
    },
    "/api/v1/employees/{employee_id}": {
      "get": {
        "operationId": "employees_get",
        "parameters": [
          {
            "in": "path",
            "name": "employee_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Employee Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "problem+json — NOT_FOUND"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chi tiết nhân viên",
        "tags": ["employees"]
      },
      "patch": {
        "operationId": "employees_update",
        "parameters": [
          {
            "in": "path",
            "name": "employee_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Employee Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployeeUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "problem+json — NOT_FOUND"
          },
          "409": {
            "description": "problem+json — STALE_VERSION | LAST_MANAGER | CANNOT_DEACTIVATE_SELF | INVALID_TRANSITION | CONFLICT (email)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sửa thông tin nhân viên",
        "tags": ["employees"]
      }
    },
