# Copy to .env (make setup does this). Never commit .env. Production values live in /opt/smyou/.env on the server.
APP_ENV=development            # development | test | production
APP_TIMEZONE=Asia/Ho_Chi_Minh

# PostgreSQL
POSTGRES_USER=smyou
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=smyou
DATABASE_URL=postgresql+psycopg://smyou:change-me-dev@db:5432/smyou
TEST_DATABASE_URL=postgresql+psycopg://smyou:change-me-dev@localhost:5432/smyou_test

# Auth — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-dev-only
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false            # true in production (HTTPS)
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# Files
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=10

# Web
CORS_ORIGINS=http://localhost:5173
WEB_PORT=8080
