# PRODUCTION on the AlmaLinux server. Copy to /opt/smyou/.env.prod on the server (chmod 600, owner deploy).
# Never commit the real file. Replace EVERY value marked CHANGE-ME. Images are built on the MacBook M2
# with `make build-prod TAG=...` (linux/amd64) and loaded on the server — this file never holds build settings.
APP_ENV=production
APP_TIMEZONE=Asia/Ho_Chi_Minh
IMAGE_TAG=CHANGE-ME            # e.g. 2026.10.01-1 — must match the tag loaded on the server

# PostgreSQL (container-internal; port is NOT published to the host)
POSTGRES_USER=smyou
POSTGRES_PASSWORD=CHANGE-ME-long-random
POSTGRES_DB=smyou
DATABASE_URL=postgresql+psycopg://smyou:CHANGE-ME-long-random@db:5432/smyou

# Auth — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-ME
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# Files (named volume mounted at /data/uploads)
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=10

# Web (nginx container). Put HTTPS (Caddy/nginx + certbot) in front — see DEPLOYMENT.md §5
CORS_ORIGINS=https://CHANGE-ME.smyou.vn
WEB_PORT=8080
